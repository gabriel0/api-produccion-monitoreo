# Valores por defecto. Copiá a `.env` para secretos reales (`.env` no se sube al repo).
# En Docker Compose, las URLs internas de Redis/Phoenix se sobrescriben en docker-compose.yml.

# ollama | gemini
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
# En Docker sin GPU conviene qwen2.5:7b; 14b en CPU satura la máquina.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_KEEP_ALIVE=2m

# Solo si LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Alternativas: gemini-2.5-flash, gemini-3.6-flash (según tu cuenta)

REDIS_URL=redis://localhost:6379
PHOENIX_URL=http://127.0.0.1:6006
PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT=pre-entrega7
API_HOST=127.0.0.1
API_PORT=8000
MAX_PASOS=4
MAX_VISITAS=2
TOP_K=4
PROMPT_VERSION=pre-entrega7-v1
JOB_TIMEOUT=600
# Con gemini, si no seteás estos, config usa 0.10 / 0.40 USD por millón.
COSTO_ENTRADA_POR_MILLON=2
COSTO_SALIDA_POR_MILLON=8
